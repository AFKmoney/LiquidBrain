# ─── LiquidBrain environment ──────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env (it is git-ignored).

# Optional: FractalBrain cognitive engine. Without it the dashboard runs in
# LLM-only mode (Think/Reflect/Train/Memory report "offline", chat still works).
# `npm run mock:brain` starts the dependency-free reference engine on :8080.
FRACTALBRAIN_URL=http://127.0.0.1:8080

# Optional: SQLite chat persistence (Prisma). The path is resolved relative to
# prisma/schema.prisma, hence "../db". Requires `npm run db:generate && npm run db:push`.
DATABASE_URL="file:../db/custom.db"

# Provider keys. Environment values apply to every visitor and win whenever a
# browser has not submitted its own; the in-app settings panel hands a key to
# the server, which keeps it in memory for that session only (never in
# localStorage, never in a request body, gone when the process restarts).
NVIDIA_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
# Only needed when you want to bypass the .z-ai-config file that
# z-ai-web-dev-sdk expects (e.g. containers with a read-only filesystem).
ZAI_BASE_URL=
